package main
import "fmt"

func main() {
    var valor_venda, valor_compra float32
  fmt.Println("Digite o valor da compra")
  fmt.Scan(&valor_compra)
  if valor_compra < 10 {
      valor_venda = valor_compra * 1.7
  } else if valor_compra < 30 {
      valor_venda = valor_compra * 1.5
  } else if valor_compra < 50 {
      valor_venda = valor_compra * 1.4
  } else {
      valor_venda = valor_compra * 1.3
  }
  fmt.Println("O valor de venda é", valor_venda)
}
