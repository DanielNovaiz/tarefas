package main

import (
	"fmt"
)

func main() {
	var n int
	fmt.Scan(&n) // lê o número de temperaturas

	for i := 0; i < n; i++ {
		var fahrenheit float64
		fmt.Scan(&fahrenheit)

		celsius := 5.0 * (fahrenheit - 32) / 9.0

		fmt.Printf("%.2f FAHRENHEIT EQUIVALE A %.2f CELSIUS\n", fahrenheit, celsius)
	}
}
