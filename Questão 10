package main

import (
	"fmt"
)

func main() {
	var a, b, c, d float64

	fmt.Println("Digite o valor de a:")
	fmt.Scan(&a)

	fmt.Println("Digite o valor de b:")
	fmt.Scan(&b)

	fmt.Println("Digite o valor de c:")
	fmt.Scan(&c)

	fmt.Println("Digite o valor de d:")
	fmt.Scan(&d)

	determinante := a*d - b*c

	fmt.Printf("O VALOR DO DETERMINANTE E = %.2f\n", determinante)
}
