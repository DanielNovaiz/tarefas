package main

import f "fmt"

func main() {
	var valor_carro float64
	precos := [4]float64{1750, 800, 1200, 2000}
	var opc int

	f.Println("Digite o valor base do carro:")
	f.Scan(&valor_carro)

	valorFinal := valor_carro
	for {
		f.Println("\nEscolha os opcionais (ou 0 para encerrar):")
		f.Println("1 - Ar-condicionado (R$ 1750)")
		f.Println("2 - Pintura metálica (R$ 800)")
		f.Println("3 - Vidro elétrico (R$ 1200)")
		f.Println("4 - Direção hidráulica (R$ 2000)")
		f.Scan(&opc)
		if opc == 0 {
			break 
		}
		if opc >= 1 && opc <= 4 {
			valorFinal += precos[opc-1]
			f.Printf("Item adicionado! Total parcial: R$ %.2f\n", valorFinal)
		} else {
			f.Println("Opção inválida!")
		}
	}

	f.Printf("\nO valor final do carro com melhorias é: R$ %.2f\n", valorFinal)
}
