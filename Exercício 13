package main
import "fmt"
func main () {
    var n, n1 int
         fmt.Println("Digite o número")
         fmt.Scan(&n)
         if n < 100 || n > 999 {
             fmt.Println("Digite um número válido")
         } else {
             n1 = (n / 10) % 10
             fmt.Println("O algarismo das dezenas é", n1)
         }
    }
