#include <stdio.h>

int main() {
    int conta;
    float consumo, valor;
    char tipo;

    scanf("%d %f %c", &conta, &consumo, &tipo);

    if (tipo == 'R') {
        valor = 5.0 + (consumo * 0.05);
    }
    else if (tipo == 'C') {
        if (consumo <= 80) {
            valor = 500.0;
        } else {
            valor = 500.0 + (consumo - 80) * 0.25;
        }
    }
    else if (tipo == 'I') {
        if (consumo <= 100) {
            valor = 800.0;
        } else {
            valor = 800.0 + (consumo - 100) * 0.04;
        }
    }

    printf("CONTA = %d\n", conta);
    printf("VALOR DA CONTA = %.2f\n", valor);

    return 0;
